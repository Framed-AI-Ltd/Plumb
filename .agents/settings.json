{
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:browser)",
      "Bash(pnpm test:calendar)",
      "Bash(pnpm build)",
      "Bash(pnpm package:smoke)",
      "Bash(pnpm catalog)",
      "Bash(go test ./...)",
      "Bash(docker compose config)",
      "Bash(docker compose ps)",
      "Bash(pnpm generate)",
      "Bash(pnpm test:rules)",
      "Bash(pnpm test:visual)",
      "Bash(pnpm verify:imports)",
      "Bash(pnpm verify:rules)",
      "Bash(pnpm build:storybook)",
      "Bash(pnpm review)",
      "Bash(pnpm review:responsive)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.aws/**)",
      "Read(~/.aws/**)",
      "Read(//proc/**/environ)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(docker compose down*)",
      "Bash(docker system prune*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.aws/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.*",
        "./**/.env",
        "./**/.env.*",
        "./.aws",
        "./**/.aws",
        "~/.aws",
        "/proc/*/environ"
      ],
      "denyWrite": [
        "~/.aws",
        "./.aws",
        "./**/.aws",
        "./.env",
        "./.env.*",
        "./**/.env",
        "./**/.env.*"
      ]
    },
    "failIfUnavailable": true,
    "network": {
      "allowLocalBinding": true
    }
  }
}
