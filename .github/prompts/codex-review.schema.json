{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "findings"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "severity",
          "file",
          "line",
          "reason",
          "suggestion"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "bug",
              "security",
              "performance",
              "maintainability"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "suggestion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          }
        }
      }
    }
  }
}
